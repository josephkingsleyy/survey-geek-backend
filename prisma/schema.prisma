generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Billing {
  id        Int       @id @default(autoincrement())
  planName  String
  amount    Float
  currency  String
  expiresAt DateTime?
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id])
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  balance      Float               @default(0)
  points       Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          Int          @id @default(autoincrement())
  walletId    Int
  type        String
  amount      Float?
  points      Int?
  description String?
  reference   String?      @unique
  createdAt   DateTime     @default(now())
  event       RewardEvent?
  wallet      Wallet       @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

model Payment {
  id          Int       @id @default(autoincrement())
  amount      Float
  currency    String    @default("NGN")
  status      String    @default("pending")
  method      String?
  reference   String    @unique
  description String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  userId      Int
  User        User      @relation(fields: [userId], references: [id])
}

model SurveyInterest {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  surveys Survey[] @relation("SurveyInterests")
  User    User[]   @relation("UserInterests")
}

model Ticket {
  id             Int            @id @default(autoincrement())
  title          String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  category       String?
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         Int
  assignedToId   Int?
  attachments    File[]
  assignedTo     User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  user           User           @relation("CreatedTickets", fields: [userId], references: [id])

  @@index([userId])
  @@index([assignedToId])
}

model File {
  id        Int      @id @default(autoincrement())
  url       String
  filename  String
  ticketId  Int?
  createdAt DateTime @default(now())
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model User {
  id                           Int              @id @default(autoincrement())
  email                        String           @unique
  emailVerifiedAt              DateTime?
  password                     String?
  username                     String?
  phoneNumber                  String?
  alternatePhoneNumber         String?
  employmentStatus             String?
  mostPreferredCommsChannel    String?
  howYouGotToKnowUs            String?
  profilePhoto                 String?
  dob                          DateTime?
  gender                       String?
  location                     String?
  occupation                   String?
  role                         String?          @default("user")
  isActive                     Boolean?         @default(false)
  otp                          String?
  otpExpiresAt                 DateTime?
  twoFactorAuth                String?
  lastLogin                    String?
  ipAddress                    String?
  browserAgent                 String?
  subscriptionPlan             String?
  subscriptionPlanExpireAt     String?
  billingId                    Int?             @unique
  bio                          String?
  referralCode                 String?
  softDelete                   Boolean?         @default(false)
  firstName                    String?
  lastName                     String?
  hasOnboarded                 Boolean?
  createdAt                    DateTime         @default(now())
  resetOtp                     String?
  resetOtpExpiresAt            DateTime?
  ageGroup                     String?
  addressOfNationality         String?
  addressOfResidence           String?
  alternatePhoneNumberDialCode String?
  cityOfNationality            String?
  cityOfResidence              String?
  countryOfNationality         String?
  countryOfResidence           String?
  phoneNumberDialCode          String?
  stateOfNationality           String?
  stateOfResidence             String?
  provider                     String?
  providerId                   String?
  accounts                     Account[]
  billing                      Billing?
  Notification                 Notification[]
  payment                      Payment[]
  questions                    Question[]
  referralUsed                 Referral?        @relation("UserReferred")
  referralsMade                Referral[]       @relation("UserReferrals")
  responses                    Response[]
  sessions                     Session[]
  surveys                      Survey[]
  assignedTickets              Ticket[]         @relation("AssignedTickets")
  createdTickets               Ticket[]         @relation("CreatedTickets")
  wallet                       Wallet?
  Withdrawal                   Withdrawal[]
  surveyInterest               SurveyInterest[] @relation("UserInterests")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Survey {
  id                 Int              @id @default(autoincrement())
  userId             Int
  title              String?
  description        String?
  status             SurveyStatus     @default(DRAFT)
  requireResponse    Boolean?         @default(false)
  minResponse        Int?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  surveyPurpose      String?
  slug               String?          @unique
  rejectionReason    String?
  audienceOccupation String?
  audienceState      String?
  modeOfCollection   String?
  questionNumber     String?
  support            String?
  targetAudience     String?
  timeline           String?
  price              Float?
  responses          Response[]
  sections           Section[]        @relation("SurveySections")
  user               User             @relation(fields: [userId], references: [id])
  surveyInterests    SurveyInterest[] @relation("SurveyInterests")
}

model Section {
  id          Int        @id @default(autoincrement())
  surveyId    Int
  title       String
  description String?
  order       Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[] @relation("SectionQuestions")
  survey      Survey     @relation("SurveySections", fields: [surveyId], references: [id])
}

model Question {
  id              Int            @id @default(autoincrement())
  sectionId       Int
  description     String?
  text            String
  type            QuestionType
  required        Boolean        @default(false)
  scaleMin        Int?
  scaleMax        Int?
  allowUpload     Boolean?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          Int?
  order           Int?
  options         Json           @default("[]")
  levels          Int?           @default(5)
  symbol          String?        @default("star")
  statements      Json?          @default("[]")
  maxFiles        Int?           @default(1)
  maxSize         Int?           @default(2048)
  uploadedFiles   Json?          @default("[]")
  matrixId        Int?           @unique
  status          QuestionStatus @default(DRAFT)
  branchCondition String?
  matrix          MatrixField?   @relation(fields: [matrixId], references: [id])
  section         Section        @relation("SectionQuestions", fields: [sectionId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  responses       Response[]
}

model MatrixField {
  id       Int       @id @default(autoincrement())
  operator String
  rows     String[]
  cols     String[]
  data     Json
  question Question?
}

model Response {
  id            Int      @id @default(autoincrement())
  userId        Int
  surveyId      Int
  questionId    Int
  answerText    String?
  rating        Int?
  uploadUrl     String?
  matrixRow     String?
  matrixCol     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  answerOption  Json?
  answerOptions Json?
  matrixAnswer  Json?
  question      Question @relation(fields: [questionId], references: [id])
  survey        Survey   @relation(fields: [surveyId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  message     String
  type        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  isImportant Boolean? @default(false)
  isStarred   Boolean? @default(false)
  user        User     @relation(fields: [userId], references: [id])
}

model Referral {
  id           Int      @id @default(autoincrement())
  referrerId   Int
  referredId   Int      @unique
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())
  referred     User     @relation("UserReferred", fields: [referredId], references: [id])
  referrer     User     @relation("UserReferrals", fields: [referrerId], references: [id])

  @@index([referrerId])
}

model Withdrawal {
  id            Int    @id @default(autoincrement())
  userId        Int
  amount        Float
  bankName      String
  accountNumber String
  accountName   String
  status        String
  approvedBy    Int?
  declinedBy    Int?
  user          User   @relation(fields: [userId], references: [id])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  PAUSED
  COMPLETED
  PENDING
  TRASH
  REJECTED
}

enum QuestionStatus {
  DRAFT
  PUBLISH
}

enum QuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  RANKING
  LIKERT
  UPLOAD
  NET_PROMOTER_SCORE
  MATRIX
  DATE_TIME
  TIME
}

enum RewardEvent {
  REFERRAL_SIGNUP
  SURVEY_PUBLISH
  SURVEY_RESPONSE
  ADMIN_ADJUSTMENT
  POINTS_PURCHASE
}
